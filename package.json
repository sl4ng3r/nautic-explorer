{
  "name": "nautic-explorer",
  "version": "0.1.11",
  "private": true,
  "description": "Minecraft Bedrock add-on for underwater exploration.",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "node tools/build.mjs",
    "validate": "node tools/validate-pack.mjs",
    "package": "npm run build && node tools/package-addon.mjs",
    "package:release": "npm run build && node tools/package-addon.mjs --release"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
